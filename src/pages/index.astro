---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
import { getCollection } from "astro:content";

const recentPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const recentStories = (await getCollection("stories", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const allRecent = [...recentPosts, ...recentStories]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "") + "/";
---

<BaseLayout title="首页" description="Shiorangerin 的个人站点 —— 信仰、技术与生活的默想。">
  <article class="msg msg--assistant">
    <div class="msg-avatar">
      <img src={base + "avatar.jpg"} alt="Shiorangerin" />
    </div>
    <div class="msg-body">
      <div class="bubble bubble--assistant">
        <p>
          <span class="bible-verse" data-ref="马太福音 11:28">凡劳苦担重担的人，可以到我这里来</span>
        </p>
        <p>
          <span class="bible-verse" data-ref="彼得前书 5:7">你们要将一切的忧虑卸给神，因为他顾念你们。</span>
        </p>
        <p>
          <span class="bible-verse" data-ref="诗篇 34:8">你们要尝尝主恩的滋味，便知道他是美善；投靠他的人有福了！</span>
        </p>
        <div class="chat-actions">
          <a href={base + "blog"} class="chat-action">
            阅读默想
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
          <a href={base + "about"} class="chat-action">关于</a>
        </div>
      </div>
    </div>
  </article>

  <article class="msg msg--assistant">
    <div class="msg-avatar">
      <img src={base + "avatar.jpg"} alt="Shiorangerin" />
    </div>
    <div class="msg-body">
      <div class="bubble bubble--assistant">
        <h2 class="msg-heading">最近更新</h2>
        {
          allRecent.length === 0 ? (
            <div class="empty-state">
              <p>暂无内容，稍后再来看看。</p>
            </div>
          ) : (
            <div class="thread-list">
              {allRecent.map((post) => (
                <BlogCard post={post} collection={post.collection} />
              ))}
              <a href={base + "blog"} class="thread">
                <div class="thread-main">
                  <div class="thread-title">
                    <span class="thread-title-text">浏览全部默想</span>
                  </div>
                  <div class="thread-meta">{recentPosts.length} 篇近期</div>
                </div>
              </a>
            </div>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>