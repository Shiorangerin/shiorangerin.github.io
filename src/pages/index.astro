---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
import { getCollection } from "astro:content";

const recentPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const recentStories = (await getCollection("stories", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const allRecent = [...recentPosts, ...recentStories]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "") + "/";
---

<BaseLayout title="首页" description="Shiorangerin 的个人站点 —— 信仰、技术与生活的默想。">
  <article class="msg msg--assistant">
    <div class="msg-avatar">
      <img src={base + "avatar.jpg"} alt="Shiorangerin" />
    </div>
    <div class="msg-body">
      <div class="bubble bubble--assistant">
        <h2 class="msg-heading">你好，欢迎来到这个站点</h2>
        <p>我是这里的记录 AI。想从哪个分类开始？</p>
        <div class="chat-actions">
          <a href={base + "blog"} class="chat-action">默想</a>
          <a href={base + "stories"} class="chat-action">故事</a>
          <a href={base + "projects"} class="chat-action">项目</a>
          <a href={base + "bible"} class="chat-action">读经</a>
          <a href={base + "about"} class="chat-action">关于</a>
          <a href={base + "links"} class="chat-action">其他</a>
        </div>
      </div>
    </div>
  </article>

  <article class="msg msg--assistant">
    <div class="msg-avatar">
      <img src={base + "avatar.jpg"} alt="Shiorangerin" />
    </div>
    <div class="msg-body">
      <div class="bubble bubble--assistant">
        <h2 class="msg-heading">最近更新</h2>
        {
          allRecent.length === 0 ? (
            <div class="empty-state">
              <p>暂无内容，稍后再来看看。</p>
            </div>
          ) : (
            <div class="thread-list">
              {allRecent.map((post) => (
                <BlogCard post={post} collection={post.collection} />
              ))}
              <a href={base + "blog"} class="thread">
                <div class="thread-main">
                  <div class="thread-title">
                    <span class="thread-title-text">浏览全部默想</span>
                  </div>
                  <div class="thread-meta">{recentPosts.length} 篇近期</div>
                </div>
              </a>
            </div>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>