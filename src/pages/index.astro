---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
import { getCollection } from "astro:content";

const recentPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const recentStories = (await getCollection("stories", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const allRecent = [...recentPosts, ...recentStories]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "") + "/";

const suggestions = [
  { href: base + "blog", name: "默想", desc: "信仰、技术与生活的记录" },
  { href: base + "stories", name: "故事", desc: "原创角色与叙事" },
  { href: base + "projects", name: "项目", desc: "GitHub 开源项目" },
  { href: base + "bible", name: "读经", desc: "圣经研读笔记" },
  { href: base + "about", name: "关于", desc: "这个站点是什么" },
  { href: base + "links", name: "其他", desc: "外站链接与小工具" },
];
---

<BaseLayout title="首页" description="Shiorangerin 的个人站点 —— 信仰、技术与生活的默想。">
  <section class="home-hero">
    <h1 class="home-hero-title">今天想读点什么？</h1>
    <div class="suggestion-grid">
      {suggestions.map((s) => (
        <a href={s.href} class="suggestion">
          <span class="suggestion-name">{s.name}</span>
          <span class="suggestion-desc">{s.desc}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="recent-section">
    <h2 class="recent-heading">最近更新</h2>
    {
      allRecent.length === 0 ? (
        <div class="empty-state">
          <p>暂无内容，稍后再来看看。</p>
        </div>
      ) : (
        <div class="thread-list">
          {allRecent.map((post) => (
            <BlogCard post={post} collection={post.collection} />
          ))}
          <a href={base + "blog"} class="thread">
            <div class="thread-main">
              <div class="thread-title">
                <span class="thread-title-text">浏览全部默想</span>
              </div>
              <div class="thread-meta">{recentPosts.length} 篇近期</div>
            </div>
          </a>
        </div>
      )
    }
  </section>
</BaseLayout>