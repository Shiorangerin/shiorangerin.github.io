---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "") + "/";
---

<BaseLayout title="404" description="这页不存在于地上" noindex>
  <article class="msg msg--assistant" style="justify-content: center;">
    <div class="msg-body" style="max-width: 100%; align-items: center; text-align: center;">
      <div class="bubble bubble--assistant">
        <h1 style="font-size: 4rem; margin: 0 0 0.5rem; background: linear-gradient(135deg, var(--accent), #8b4513); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">404</h1>
        <p style="font-size: 1.2rem; color: var(--text-secondary); margin-bottom: 1.5rem;">这页不存在于地上</p>
        <a href={base} class="chat-action">回到首页</a>
      </div>
    </div>
  </article>
</BaseLayout>