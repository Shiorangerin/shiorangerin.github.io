---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import SearchBar from "../../components/SearchBar.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("stories", ({ data }) => !data.draft);
const pinned = posts.filter((p) => p.data.pinned).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const unpinned = posts.filter((p) => !p.data.pinned).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const sorted = [...pinned, ...unpinned];
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "") + "/";
---

<BaseLayout title="故事" description="Shiorangerin 的 OC 故事集。">
  <SearchBar slot="composer" placeholder="搜索故事…" />

  <div id="blog-list" class="thread-list">
    {
      sorted.length === 0 ? (
        <div class="empty-state">
          暂无故事，稍后再来看看。
        </div>
      ) : (
        sorted.map((post) => (
          <div class="thread-item">
            <BlogCard post={post} collection="stories" />
          </div>
        ))
      )
    }
    <a href={base + "rss.xml"} class="thread">
      <div class="thread-main">
        <div class="thread-title">
          <span class="thread-title-text">RSS 订阅</span>
        </div>
        <div class="thread-meta">通过 RSS 跟踪最新故事</div>
      </div>
    </a>
  </div>
</BaseLayout>

<script>
  import Fuse from "fuse.js";

  const searchInput = document.getElementById("blog-search") as HTMLInputElement | null;
  if (searchInput) {
    const cards = document.querySelectorAll<HTMLElement>("#blog-list > div");
    const data = Array.from(cards).map((el) => ({
      el,
      title: el.querySelector(".blog-card-title")?.textContent ?? "",
      desc: el.querySelector(".blog-card-desc")?.textContent ?? "",
      meta: el.querySelector(".blog-card-meta")?.textContent ?? "",
    }));

    const fuse = new Fuse(data, {
      keys: ["title", "desc", "meta"],
      threshold: 0.35,
    });

    searchInput.addEventListener("input", () => {
      const q = searchInput.value.trim();
      if (!q) {
        cards.forEach((c) => { c.style.display = ""; });
        return;
      }
      const results = new Set(fuse.search(q).map((r) => r.item.el));
      cards.forEach((c) => {
        c.style.display = results.has(c as HTMLElement) ? "" : "none";
      });
    });
  }
</script>