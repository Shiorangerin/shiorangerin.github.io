---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "") + "/";
---

<BaseLayout title="其他链接" description="他人在此托管的内容。">
  <div class="thread-list">
    <a href="/cktcb" class="thread">
      <div class="thread-main">
        <div class="thread-title">
          <span class="thread-title-text">CANDLELIGHT · 海龟汤故事集</span>
        </div>
        <p class="thread-desc">
          一个收藏诡异风格短篇故事的站点，源自群友创作。收录各类悬疑、惊悚及超自然主题的叙事作品。页面风格为暗色古典，带有「CLASSIFIED ARCHIVE ACCESS」的档案馆气质。
        </p>
        <div class="thread-meta">
          <span>暗色古典 · 档案馆风格</span>
        </div>
      </div>
    </a>

    <a href="/EFSC" class="thread">
      <div class="thread-main">
        <div class="thread-title">
          <span class="thread-title-text">EFSC · 终末地代肝价目表生成器</span>
        </div>
        <p class="thread-desc">
          基于《明日方舟：终末地》风格设计的代肝服务价目表在线生成工具。支持自定义商品列表、操作员信息、预设模板，提供暗/亮双主题，并可直接导出为 900×1200 竖版 PNG 图片。
        </p>
        <div class="thread-meta">
          <span>在线工具 · 暗/亮双主题 · PNG 导出</span>
        </div>
      </div>
    </a>

    <a href="https://shiorangerin.github.io/mac-folder-icns/" class="thread" target="_blank" rel="noopener noreferrer">
      <div class="thread-main">
        <div class="thread-title">
          <span class="thread-title-text">mac-folder-icns · macOS 文件夹图标画廊</span>
        </div>
        <p class="thread-desc">
          收录 559 个 macOS .icns 文件夹图标的浏览画廊：无限画布、搜索、系列筛选、暗色模式，支持一键下载。基于 Next.js 15 + Tailwind v4 + Framer Motion，静态导出部署到 GitHub Pages。
        </p>
        <div class="thread-meta">
          <span>图标画廊 · 搜索/筛选 · 一键下载</span>
        </div>
      </div>
    </a>
  </div>
</BaseLayout>