---
import type { CollectionEntry } from "astro:content";

type AnyPost = CollectionEntry<"blog"> | CollectionEntry<"stories">;

interface Props {
  post: AnyPost;
  collection?: string;
}

const { post, collection = "blog" } = Astro.props;
const { title, description, date, tags, pinned } = post.data;
const readingTime = Math.max(1, Math.ceil((post.body?.length ?? 0) / 400));
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "") + "/";
---

<a href={base + collection + "/" + post.id.replace(/\.md$/, "")} class="blog-card thread">
  <div class="thread-main">
    <div class="thread-title blog-card-title">
      {pinned && <span class="pinned-badge">置顶</span>}
      <span class="thread-title-text">{title}</span>
    </div>
    <p class="thread-desc blog-card-desc">{description}</p>
    <div class="thread-meta blog-card-meta">
      <span>阅读约 {readingTime} 分钟</span>
      {tags.length > 0 && (
        <span>{tags.slice(0, 3).map((t) => `#${t}`).join(" ")}</span>
      )}
    </div>
  </div>
  <time class="thread-date" datetime={date.toISOString()}>
    {date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
  </time>
</a>